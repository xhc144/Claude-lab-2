     "end": 10.014
    }
   ]
  },
  "mobius": {
   "dur": 15.224,
   "sents": [
    {
     "sub": "所以，曲线上所有无序点对构成的空间，就是一条莫比乌斯带。",
     "start": 0.0,
     "end": 8.389
