     "end": 9.869
    }
   ]
  },
  "lift": {
   "dur": 18.37,
   "sents": [
    {
     "sub": "第二个关键想法：把每一对点，变成三维空间中的一个点。",
     "start": 0.0,
     "end": 6.585
